# Copy to .env (never committed) for docker compose. All optional.

# Jev bandleader through the server's relay (a TypeSafe API key).
TYPESAFE_API_KEY=
# Claude bandleader through the server's relay; without it, paste a key in the page.
ANTHROPIC_API_KEY=

# The local model for `docker compose --profile local-llm up`.
# Smaller machines: qwen3:4b-instruct-2507-q4_K_M
JAMSTATE_OLLAMA_MODEL=qwen3:30b-a3b-instruct-2507-q4_K_M
# Or point the relay at a model server you already run (llama.cpp, vLLM, Ollama on the host):
# JAMSTATE_LLM_URL=http://host.docker.internal:8080/v1

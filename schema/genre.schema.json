{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/thi-mb/jamstate/schema/genre.schema.json",
  "title": "jamstate genre pack",
  "description": "One genre: how the band composes in it (v0.1), who plays and how it is mixed (v0.2). Later releases add listening and leading layers to the same file. Format: docs/decisions/0012-genre-pack-format.md and 0018-lineups-and-sound.md. The browser (web/src/core/genre.ts) enforces the same rules with clearer messages.",
  "type": "object",
  "required": ["format", "id", "name", "drums", "bass", "chords"],
  "additionalProperties": false,
  "$defs": {
    "keyScaleList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "notes"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "notes": { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 11 }, "uniqueItems": true, "contains": { "const": 0 } }
        }
      }
    },
    "slot": {
      "oneOf": [
        { "type": "string", "description": "Instrument id (sounds/instruments.json), e.g. upright, brushes, organ." },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "instrument": { "type": "string" },
            "volume": { "type": "number", "minimum": 0, "maximum": 1 },
            "pan": { "type": "number", "minimum": -1, "maximum": 1, "description": "-1 left, 1 right." }
          }
        }
      ]
    },
    "band": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "description": "Who plays: part → instrument. A part that isn't listed sits out.",
      "properties": {
        "drums": { "$ref": "#/$defs/slot" },
        "bass": { "$ref": "#/$defs/slot" },
        "chords": { "$ref": "#/$defs/slot", "description": "The keys player." },
        "guitar": { "$ref": "#/$defs/slot" },
        "pad": { "$ref": "#/$defs/slot" },
        "percussion": { "$ref": "#/$defs/slot" }
      }
    },
    "percRow": { "type": "string", "pattern": "^[.xXg |]+$", "description": "One character per step: . rest, x hit, X accent, g ghost." },
    "percLines": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tambourine": { "$ref": "#/$defs/percRow" }, "cowbell": { "$ref": "#/$defs/percRow" }, "bongo_hi": { "$ref": "#/$defs/percRow" },
        "bongo_lo": { "$ref": "#/$defs/percRow" }, "conga_mute": { "$ref": "#/$defs/percRow" }, "conga_hi": { "$ref": "#/$defs/percRow" },
        "conga_lo": { "$ref": "#/$defs/percRow" }, "cabasa": { "$ref": "#/$defs/percRow" }, "shaker": { "$ref": "#/$defs/percRow" },
        "claves": { "$ref": "#/$defs/percRow" }
      }
    },
    "percVariant": {
      "oneOf": [
        { "$ref": "#/$defs/percLines" },
        {
          "type": "object",
          "required": ["lines"],
          "additionalProperties": false,
          "properties": { "lines": { "$ref": "#/$defs/percLines" }, "weight": { "type": "number", "minimum": 0, "maximum": 100 }, "phrase_end": { "type": "boolean" } }
        }
      ]
    },
    "comping": {
      "type": "object",
      "required": ["levels"],
      "additionalProperties": false,
      "properties": {
        "grid": { "$ref": "#/$defs/grid" },
        "voicing": { "enum": ["close", "shell", "triad", "stab", "power", "grip", "shell3"], "description": "Keys voicings, plus guitar ones: power (root, 5th, octave), grip (full barre shape), shell3 (root, 7th, 3rd)." },
        "range": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "integer", "minimum": 24, "maximum": 108 } },
        "levels": {
          "allOf": [{ "$ref": "#/$defs/levels" }, { "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/tokenVariant" } } }],
          "description": "Steps: . rest, - hold, x hit, X accent, g muted ghost (a funk chank), p push."
        }
      }
    },
    "partMix": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "volume": { "type": "number", "minimum": 0, "maximum": 1 },
        "pan": { "type": "number", "minimum": -1, "maximum": 1 },
        "eq": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number", "minimum": -12, "maximum": 12 }, "description": "Low shelf 100 Hz, presence 1.5 kHz, high shelf 8 kHz, in dB." },
        "comp": { "type": "number", "minimum": 0, "maximum": 1, "description": "How hard the part's compressor works." },
        "reverb": { "type": "number", "minimum": 0, "maximum": 1, "description": "Send to the shared room." },
        "tune": { "type": "number", "minimum": -12, "maximum": 12, "description": "Drum tuning in semitones." },
        "drive": { "type": "number", "minimum": 0, "maximum": 1, "description": "Amp drive on top of the instrument's own amp: 0 none, 1 a lot." }
      }
    },
    "perLevel": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "type": "number", "minimum": 0, "maximum": 1 },
      "description": "One value per intensity level (0 = sparsest, 3 = fullest)."
    },
    "grid": { "enum": [2, 3, 4], "default": 4, "description": "Steps per beat: 2 = eighths, 3 = triplets, 4 = sixteenths." },
    "drumRow": {
      "type": "string",
      "pattern": "^[.xXgoh |]+$",
      "description": "One character per step: . rest, x hit, X accent, h soft, g ghost, o open (open hat, or bell on the ride). Spaces and | are ignored."
    },
    "drumLines": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kick": { "$ref": "#/$defs/drumRow" },
        "snare": { "$ref": "#/$defs/drumRow" },
        "stick": { "$ref": "#/$defs/drumRow" },
        "cymbal": { "$ref": "#/$defs/drumRow", "description": "The time-keeping line, played on the hi-hat or ride depending on the section." },
        "pedal": { "$ref": "#/$defs/drumRow" },
        "tom_hi": { "$ref": "#/$defs/drumRow" },
        "tom_mid": { "$ref": "#/$defs/drumRow" },
        "tom_lo": { "$ref": "#/$defs/drumRow" },
        "crash": { "$ref": "#/$defs/drumRow" },
        "clap": { "$ref": "#/$defs/drumRow" }
      }
    },
    "drumVariant": {
      "oneOf": [
        { "$ref": "#/$defs/drumLines" },
        {
          "type": "object",
          "required": ["lines"],
          "additionalProperties": false,
          "properties": {
            "lines": { "$ref": "#/$defs/drumLines" },
            "weight": { "type": "number", "minimum": 0, "maximum": 100 },
            "phrase_end": { "type": "boolean", "description": "Only on the last bar of a phrase." }
          }
        }
      ]
    },
    "tokenVariant": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "required": ["steps"],
          "additionalProperties": false,
          "properties": {
            "steps": { "type": "string", "minLength": 1 },
            "weight": { "type": "number", "minimum": 0, "maximum": 100 },
            "phrase_end": { "type": "boolean" }
          }
        }
      ]
    },
    "levels": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "description": "Pattern variants for each intensity level; one is picked per bar, seeded."
    },
    "humanize": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "offset_ms": { "type": "number", "minimum": -30, "maximum": 30, "description": "Negative pushes ahead of the beat, positive lays back." },
        "jitter_ms": { "type": "number", "minimum": 0, "maximum": 20 },
        "velocity": { "type": "number", "minimum": 0, "maximum": 30 },
        "spread_ms": { "type": "number", "minimum": 0, "maximum": 40, "description": "Chords: roll the notes low to high." },
        "lines": { "type": "object", "additionalProperties": { "type": "number", "minimum": -30, "maximum": 30 }, "description": "Drums: offset per line, ms." }
      }
    }
  },
  "properties": {
    "format": { "enum": ["jamstate-genre/0.2", "jamstate-genre/0.1"], "description": "0.1 packs still load: drums, bass and keys on default sounds and mix." },
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "parts": { "type": "array", "items": { "enum": ["drums", "bass", "chords", "guitar", "pad", "percussion"] }, "minItems": 1, "description": "Roles this genre has grooves for (a section for each)." },
    "band": { "$ref": "#/$defs/band", "description": "The default lineup." },
    "lineups": {
      "type": "array",
      "description": "Other lineups that suit the genre; the page offers them.",
      "items": {
        "type": "object",
        "required": ["id", "name", "band"],
        "additionalProperties": false,
        "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "band": { "$ref": "#/$defs/band" } }
      }
    },
    "mix": {
      "type": "object",
      "additionalProperties": false,
      "description": "Production: the room, the master and a channel strip per part.",
      "properties": {
        "reverb": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "seconds": { "type": "number", "minimum": 0.2, "maximum": 6 }, "tone": { "type": "number", "minimum": 0, "maximum": 1, "description": "0 dark, 1 bright." } }
        },
        "saturation": { "type": "number", "minimum": 0, "maximum": 1, "description": "Tape-style saturation on the master." },
        "gain": { "type": "number", "minimum": 0, "maximum": 1.5, "description": "Master level before the limiter." },
        "parts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "drums": { "$ref": "#/$defs/partMix" }, "bass": { "$ref": "#/$defs/partMix" }, "chords": { "$ref": "#/$defs/partMix" },
            "guitar": { "$ref": "#/$defs/partMix" }, "pad": { "$ref": "#/$defs/partMix" }, "percussion": { "$ref": "#/$defs/partMix" }
          }
        }
      }
    },
    "feel": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "swing": { "type": "number", "minimum": 0, "maximum": 1, "description": "0 = straight, 0.66 = triplet, 1 = dotted." },
        "swing_unit": { "enum": [8, 16], "description": "Swing eighths or sixteenths." }
      }
    },
    "humanize": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "drums": { "$ref": "#/$defs/humanize" }, "bass": { "$ref": "#/$defs/humanize" }, "chords": { "$ref": "#/$defs/humanize" },
        "guitar": { "$ref": "#/$defs/humanize" }, "pad": { "$ref": "#/$defs/humanize" }, "percussion": { "$ref": "#/$defs/humanize" }
      }
    },
    "drums": {
      "type": "object",
      "required": ["levels", "fills"],
      "additionalProperties": false,
      "properties": {
        "grid": { "$ref": "#/$defs/grid" },
        "cymbal": { "enum": ["hat", "ride"] },
        "cymbal_sections": { "type": "object", "additionalProperties": { "enum": ["hat", "ride"] }, "description": "Section name → hat or ride." },
        "levels": { "allOf": [{ "$ref": "#/$defs/levels" }, { "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/drumVariant" } } }] },
        "ghosts": { "$ref": "#/$defs/perLevel", "description": "Chance of an extra ghost snare on each empty off-beat sixteenth." },
        "phrase_fills": { "$ref": "#/$defs/perLevel", "description": "Chance of a short fill at the end of a phrase (not a section)." },
        "fills": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["beats", "lines"],
            "additionalProperties": false,
            "properties": {
              "beats": { "type": "number", "minimum": 0.5, "maximum": 4 },
              "levels": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "integer", "minimum": 0, "maximum": 3 } },
              "lines": { "$ref": "#/$defs/drumLines" }
            }
          }
        },
        "pickup": { "$ref": "#/$defs/drumLines", "description": "One beat played at the end of the count-in." }
      }
    },
    "bass": {
      "type": "object",
      "required": ["levels"],
      "additionalProperties": false,
      "properties": {
        "grid": { "$ref": "#/$defs/grid" },
        "levels": {
          "allOf": [{ "$ref": "#/$defs/levels" }, { "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/tokenVariant" } } }],
          "description": "Space-separated steps: . rest, - hold, R root, 2 b3 3 4 b5 5 6 b7 7 8 degrees of the current chord (suffix ' up an octave, , down), A approach to the next chord, N the next chord's root early, x dead note, g ghost; ! accents."
        },
        "approach": { "enum": ["chromatic", "scale", "fifth", "mixed"] },
        "approach_chance": { "$ref": "#/$defs/perLevel", "description": "Chance the last note of a bar becomes an approach to the next chord." },
        "walk": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "levels": { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 3 }, "description": "Levels at which the bass walks quarter notes instead of the patterns." },
            "skip_chance": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        }
      }
    },
    "chords": {
      "type": "object",
      "required": ["levels"],
      "additionalProperties": false,
      "properties": {
        "grid": { "$ref": "#/$defs/grid" },
        "voicing": { "enum": ["close", "shell", "triad", "stab"] },
        "range": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "integer", "minimum": 24, "maximum": 108 } },
        "levels": {
          "allOf": [{ "$ref": "#/$defs/levels" }, { "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/tokenVariant" } } }],
          "description": "Steps: . rest, - hold, x hit, X accent, g muted ghost, p push (play the next chord early)."
        }
      }
    },
    "guitar": { "$ref": "#/$defs/comping", "description": "Rhythm guitar comping." },
    "pad": { "$ref": "#/$defs/comping", "description": "Held chords (strings, pads); long notes split at each chord change." },
    "percussion": {
      "type": "object",
      "required": ["levels"],
      "additionalProperties": false,
      "properties": {
        "grid": { "$ref": "#/$defs/grid" },
        "levels": { "allOf": [{ "$ref": "#/$defs/levels" }, { "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/percVariant" } } }] }
      }
    },
    "ending": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rit": { "type": "number", "minimum": 0, "maximum": 0.5, "description": "Tempo drop across the last bar (0.3 = to 70%)." },
        "ring_beats": { "type": "number", "minimum": 0.5, "maximum": 8 },
        "chord": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "major": { "type": "string" }, "minor": { "type": "string" } },
          "description": "Chord quality of the final tonic chord, e.g. 9, 69, m9, m6."
        },
        "drums": { "enum": ["hit", "roll"] }
      }
    },
    "forms": { "type": "array", "items": { "type": "string" }, "description": "Typical forms, for writing songs in this genre (v0.6)." },
    "progressions": { "type": "array", "items": { "type": "string" }, "description": "Typical progressions in Roman numerals (v0.6)." },
    "listening": {
      "description": "What the band listens for (v0.3, docs/decisions/0019-listening-layer.md): per chord class, the scale (semitones above the chord's root) whose notes count as colour rather than outside, and whether the rule leader holds or lifts when the player plays outside. Without it: the chord's own scale, and hold.",
      "type": "object",
      "required": ["scales"],
      "additionalProperties": false,
      "properties": {
        "scales": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "major": { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 11 }, "uniqueItems": true },
            "minor": { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 11 }, "uniqueItems": true },
            "dominant": { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 11 }, "uniqueItems": true },
            "half_diminished": { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 11 }, "uniqueItems": true },
            "diminished": { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 11 }, "uniqueItems": true }
          }
        },
        "outside": { "enum": ["hold", "lift"] },
        "key_scales": {
          "description": "Scales to hold for a whole song (the fretboard's scale mode), per key mode, in order of preference; the one that fits the chart's chords best is used. Without it: the plain major or natural minor scale.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "major": { "$ref": "#/$defs/keyScaleList" },
            "minor": { "$ref": "#/$defs/keyScaleList" }
          }
        }
      }
    }
  }
}
